#!/usr/bin/env bash
# Installs Nginx, keeps the /redirect_me 301 redirect and adds a custom 404 page
SUDO=""
if [ "$(id -u)" -ne 0 ]; then
    SUDO="sudo"
fi

$SUDO apt-get update -y
$SUDO apt-get install -y nginx

echo "Hello World!" | $SUDO tee /var/www/html/index.html > /dev/null
echo "Ceci n'est pas une page" | $SUDO tee /var/www/html/404.html > /dev/null

if ! grep -q "location /redirect_me" /etc/nginx/sites-available/default; then
    $SUDO sed -i 's|server_name _;|server_name _;\n\n\tlocation /redirect_me {\n\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\t}|' /etc/nginx/sites-available/default
fi

if ! grep -q "error_page 404" /etc/nginx/sites-available/default; then
    $SUDO sed -i 's|server_name _;|server_name _;\n\n\terror_page 404 /404.html;\n\tlocation = /404.html {\n\t\tinternal;\n\t}|' /etc/nginx/sites-available/default
fi

$SUDO service nginx restart
