#!/usr/bin/env bash
# Configures the container so Nginx runs as the nginx user and listens on port 8080
pkill apache2
sed -i 's/^#\?\s*user .*;/user nginx;/' /etc/nginx/nginx.conf
sed -i 's/80 default_server/8080 default_server/g' /etc/nginx/sites-available/default
chmod 644 /etc/nginx/nginx.conf
sudo -u nginx service nginx restart
